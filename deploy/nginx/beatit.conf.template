# Isolated Nginx instance: bind only the public-facing NIC, preserving Tailscale.
user www-data;
worker_processes auto;
worker_shutdown_timeout 15s;
pid /run/beatit-nginx/nginx.pid;
error_log /var/log/beatit-nginx/error.log error;

events { worker_connections 1024; }

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # OAuth callback query parameters and cookies must not enter access logs.
    log_format beatit '$remote_addr [$time_local] "$request_method $uri $server_protocol" '
                      '$status $body_bytes_sent request=$request_time upstream=$upstream_response_time';
    access_log /var/log/beatit-nginx/access.log beatit;
    sendfile on;
    server_tokens off;
    keepalive_timeout 65;
    client_max_body_size 1100m;
    client_body_timeout 60s;
    client_body_temp_path /var/lib/beatit-nginx/body;
    proxy_temp_path /var/lib/beatit-nginx/proxy;

    server {
        listen __BIND_ADDRESS__:80;
        server_name __HOSTNAME__;
        location ^~ /.well-known/acme-challenge/ {
            root /var/lib/beatit-nginx/acme;
            default_type text/plain;
            add_header Cache-Control "no-store" always;
            try_files $uri =404;
        }
        location / { return 308 https://__HOSTNAME__$request_uri; }
    }

    server {
        listen __BIND_ADDRESS__:443 ssl http2;
        server_name __HOSTNAME__;
        ssl_certificate /etc/letsencrypt/live/__HOSTNAME__/fullchain.pem;
        ssl_certificate_key /etc/letsencrypt/live/__HOSTNAME__/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:BeatitTLS:10m;
        ssl_session_timeout 1d;

        location / {
            proxy_pass http://127.0.0.1:__UPSTREAM_PORT__;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Connection "";
            # Forward upload bytes immediately, and flush SSE/media promptly.
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_cache off;
            proxy_connect_timeout 5s;
            proxy_send_timeout 60s;
            proxy_read_timeout 300s;
        }
    }
}
