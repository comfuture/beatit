[Unit]
Description=Beatit direct HTTPS reverse proxy
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
RuntimeDirectory=beatit-nginx
LogsDirectory=beatit-nginx
StateDirectory=beatit-nginx
ExecStartPre=/usr/sbin/nginx -t -c /etc/beatit-nginx/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/beatit-nginx/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/beatit-nginx/nginx.conf -s reload
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
KillSignal=SIGQUIT
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/run/beatit-nginx /var/lib/beatit-nginx /var/log/beatit-nginx

[Install]
WantedBy=multi-user.target
