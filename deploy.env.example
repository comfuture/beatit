# Copy to .env. Keep this service on loopback or a private network: it has no login.
BEATIT_BIND_ADDRESS=127.0.0.1
BEATIT_PORT=18000
# Multi-user auth, dedicated MySQL and private objects are required.
# Merge .env.multiuser.example into the protected deployment environment.
BEATIT_PUBLIC_URL=https://beatit.changkyun.kim
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
BEATIT_DATABASE_URL=
BEATIT_S3_ENDPOINT=
BEATIT_S3_REGION=auto
BEATIT_S3_BUCKET=beatit
BEATIT_S3_ACCESS_KEY_ID=
BEATIT_S3_SECRET_ACCESS_KEY=
BEATIT_ALLOWED_HOSTS=localhost
BEATIT_IMAGE=beatit:local
# This deployment uses Modal; the application default without configuration is local.
# Service-level choice only; no engine selector is exposed to users.
BEATIT_EXECUTION_BACKEND=modal
BEATIT_MODAL_APP=beatit
BEATIT_MODAL_IMAGE=beatit-processing:py312-cu128-volume-8e06b89eeb19-v1
MODAL_ENVIRONMENT=main
# For Docker, use a Modal service-user token restricted to the target environment.
# Local CLI development can use `uv run modal setup` instead.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
# Alternatively use `-f compose.yaml -f compose.modal.yaml` and secret files:
# BEATIT_MODAL_TOKEN_ID_FILE=/absolute/path/to/modal-token-id
# BEATIT_MODAL_TOKEN_SECRET_FILE=/absolute/path/to/modal-token-secret
# For a native service, set MODAL_TOKEN_ID_FILE and MODAL_TOKEN_SECRET_FILE directly.
