# Copy these values into the ignored .env file or a secret manager.
# Never paste credentials in an issue, pull request, or chat.

# Use the existing OCI MySQL service through the private cloudflared/Tailscale
# route, with a dedicated Beatit database and app user. Remote TLS defaults to
# VERIFY_IDENTITY (certificate chain + hostname verification).
# OCI-generated cert with a different hostname: pin its CA and explicitly use
# mysql://beatit:PASSWORD@127.0.0.1:13306/beatit?ssl_ca=/absolute/path/to/mysql-ca.pem&ssl_mode=VERIFY_CA
# VERIFY_CA still requires a valid certificate signed by the supplied CA.
BEATIT_DATABASE_URL=
BEATIT_DB_POOL_SIZE=6

# Create a PRIVATE S3-compatible object bucket named beatit.
# For Cloudflare R2, use an API token limited to this bucket.
BEATIT_S3_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
BEATIT_S3_REGION=auto
BEATIT_S3_BUCKET=beatit
# Same-origin authenticated playback. /media works with direct Nginx or the R2 Worker.
BEATIT_MEDIA_BASE_URL=
# chunked for Cloudflare-proxied hosts; direct only after DNS points to Nginx.
BEATIT_UPLOAD_MODE=chunked
BEATIT_S3_ACCESS_KEY_ID=
BEATIT_S3_SECRET_ACCESS_KEY=

# Google Auth Platform > Clients > Web application.
# Authorized redirect URI: BEATIT_PUBLIC_URL + /api/auth/callback
# Use HTTPS in production; localhost HTTP is supported for development.
BEATIT_PUBLIC_URL=https://beatit.changkyun.kim
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Existing deployment configuration:
BEATIT_ALLOWED_HOSTS=beatit.changkyun.kim,localhost
BEATIT_BIND_ADDRESS=127.0.0.1
BEATIT_PORT=18000
BEATIT_EXECUTION_BACKEND=local
