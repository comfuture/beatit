{
  "name": "beatit-studio",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt generate && node scripts/install-web.mjs",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview:e2e": "vite preview --host 127.0.0.1 --port 3100 --strictPort --outDir .output/public",
    "postinstall": "nuxt prepare"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.107",
    "@nuxt/ui": "4.11.3",
    "nuxt": "4.6.1",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.6.5",
    "typescript": "^5.9.0",
    "vite": "8.3.4",
    "vitest": "^4.1.11",
    "vue-tsc": "^3.1.0"
  },
  "overrides": {
    "simple-git": "4.0.2"
  }
}
